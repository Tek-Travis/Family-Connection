import React from 'react';

export const FamilyDinnerIllustration: React.FC<{ className?: string }> = ({ className = 'w-full h-48' }) => (
  <svg
    viewBox="0 0 600 240"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    className={`${className} rounded-2xl overflow-hidden`}
  >
    <defs>
      <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stopColor="#404040" />
        <stop offset="50%" stopColor="#525252" />
        <stop offset="100%" stopColor="#262626" />
      </linearGradient>
      <radialGradient id="lampGlow" cx="50%" cy="30%" r="50%">
        <stop offset="0%" stopColor="#ffffff" stopOpacity="0.4" />
        <stop offset="100%" stopColor="#ffffff" stopOpacity="0" />
      </radialGradient>
      <linearGradient id="tableGrad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stopColor="#737373" />
        <stop offset="100%" stopColor="#404040" />
      </linearGradient>
    </defs>

    {/* Cozy Room Background */}
    <rect width="600" height="240" rx="16" fill="var(--bg-color)" />

    {/* Pendant Lamp Glow */}
    <circle cx="300" cy="80" r="130" fill="url(#lampGlow)" />
    <line x1="300" y1="0" x2="300" y2="45" stroke="#ffffff" strokeWidth="2.5" />
    <path d="M280 45 L320 45 L335 70 L265 70 Z" fill="#a3a3a3" />
    <circle cx="300" cy="74" r="8" fill="#fafafa" />

    {/* Wooden Dining Table */}
    <ellipse cx="300" cy="180" rx="220" ry="45" fill="url(#tableGrad)" stroke="#a3a3a3" strokeWidth="2" />
    <ellipse cx="300" cy="172" rx="190" ry="32" fill="#525252" opacity="0.6" />

    {/* Centerpiece & Dishes */}
    <circle cx="300" cy="170" r="18" fill="#e5e5e5" opacity="0.8" />
    <circle cx="300" cy="170" r="14" fill="#a3a3a3" />
    <ellipse cx="230" cy="176" rx="12" ry="7" fill="#fafafa" opacity="0.9" />
    <ellipse cx="370" cy="176" rx="12" ry="7" fill="#fafafa" opacity="0.9" />

    {/* Family Characters Gathering Warmly (Silhouettes with gentle highlights) */}
    {/* Left Parent */}
    <circle cx="160" cy="120" r="20" fill="#f5f5f5" />
    <path d="M140 115 Q160 90 180 115 Q170 100 150 102 Z" fill="#404040" />
    <path d="M125 190 Q120 145 160 145 Q200 145 195 190 Z" fill="#a3a3a3" />

    {/* Child 1 */}
    <circle cx="230" cy="130" r="15" fill="#e5e5e5" />
    <path d="M216 126 Q230 110 244 126 Q238 116 222 118 Z" fill="#737373" />
    <path d="M205 185 Q205 152 230 152 Q255 152 255 185 Z" fill="#d4d4d4" />

    {/* Child 2 */}
    <circle cx="370" cy="130" r="15" fill="#e5e5e5" />
    <path d="M356 126 Q370 110 384 126 Q378 116 362 118 Z" fill="#262626" />
    <path d="M345 185 Q345 152 370 152 Q395 152 395 185 Z" fill="#a3a3a3" />

    {/* Right Parent / Elder */}
    <circle cx="440" cy="120" r="20" fill="#e5e5e5" />
    <path d="M420 116 Q440 94 460 116 Q450 102 430 104 Z" fill="#a3a3a3" />
    <path d="M405 190 Q400 145 440 145 Q480 145 475 190 Z" fill="#737373" />

    {/* Subtitle tag */}
    <rect x="135" y="200" width="330" height="26" rx="13" fill="#000000" fillOpacity="0.4" />
    <text
      x="300"
      y="217"
      textAnchor="middle"
      fill="#ffffff"
      fontSize="20"
      fontWeight="700"
      letterSpacing="1.5"
      fontFamily="Public Sans, sans-serif"
    >
      ENTER PRIVATE FAMILY GROUP CHAT
    </text>
  </svg>
);

export const SplashEmblem: React.FC<{ className?: string }> = ({ className = 'w-48 h-48' }) => (
  <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" className={className}>
    <defs>
      <linearGradient id="shieldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stopColor="#ffffff" stopOpacity="0.25" />
        <stop offset="100%" stopColor="#ffffff" stopOpacity="0.05" />
      </linearGradient>
    </defs>
    {/* Concentric rings */}
    <circle cx="100" cy="100" r="92" stroke="#ffffff" strokeOpacity="0.15" strokeWidth="1.5" strokeDasharray="4 4" />
    <circle cx="100" cy="100" r="78" stroke="#ffffff" strokeOpacity="0.3" strokeWidth="2" />

    {/* Shield */}
    <path
      d="M100 45 C125 45 145 52 145 68 C145 110 115 140 100 152 C85 140 55 110 55 68 C55 52 75 45 100 45 Z"
      fill="url(#shieldGrad)"
      stroke="#ffffff"
      strokeWidth="2.5"
    />

    {/* Family Nodes Interconnected */}
    {/* Parent 1 Node */}
    <circle cx="85" cy="85" r="9" fill="#ffffff" />
    {/* Parent 2 Node */}
    <circle cx="115" cy="85" r="9" fill="#ffffff" />
    {/* Child Node */}
    <circle cx="100" cy="115" r="8" fill="#ffffff" />

    {/* Connection Lines */}
    <line x1="85" y1="85" x2="115" y2="85" stroke="#ffffff" strokeWidth="2.5" />
    <line x1="85" y1="85" x2="100" y2="115" stroke="#ffffff" strokeWidth="2.5" />
    <line x1="115" y1="85" x2="100" y2="115" stroke="#ffffff" strokeWidth="2.5" />

    {/* Tiny lock icon */}
    <rect x="94" y="128" width="12" height="10" rx="2" fill="#ffffff" opacity="0.9" />
    <path d="M96 128 V124 C96 121.8 97.8 120 100 120 C102.2 120 104 121.8 104 124 V128" stroke="#ffffff" strokeWidth="2" fill="none" opacity="0.9" />
  </svg>
);

/**
 * Procedural offline SVG QR code generator for Invite Codes
 */
export const QRCodeSVG: React.FC<{ value: string; size?: number }> = ({ value, size = 180 }) => {
  // Generate deterministic binary matrix from string
  const gridSize = 21;
  const matrix: boolean[][] = Array.from({ length: gridSize }, () => Array(gridSize).fill(false));

  // Corner finder patterns (7x7)
  const drawFinder = (startX: number, startY: number) => {
    for (let r = 0; r < 7; r++) {
      for (let c = 0; c < 7; c++) {
        if (
          r === 0 ||
          r === 6 ||
          c === 0 ||
          c === 6 ||
          (r >= 2 && r <= 4 && c >= 2 && c <= 4)
        ) {
          matrix[startY + r][startX + c] = true;
        }
      }
    }
  };

  drawFinder(0, 0); // Top-left
  drawFinder(gridSize - 7, 0); // Top-right
  drawFinder(0, gridSize - 7); // Bottom-left

  // Timing lines
  for (let i = 8; i < gridSize - 8; i++) {
    matrix[6][i] = i % 2 === 0;
    matrix[i][6] = i % 2 === 0;
  }

  // Hash payload into remaining grid bits
  let seed = 0;
  for (let i = 0; i < value.length; i++) {
    seed = (seed * 31 + value.charCodeAt(i)) & 0xffffffff;
  }

  for (let r = 0; r < gridSize; r++) {
    for (let c = 0; c < gridSize; c++) {
      const inTopLeft = r < 8 && c < 8;
      const inTopRight = r < 8 && c >= gridSize - 8;
      const inBottomLeft = r >= gridSize - 8 && c < 8;
      if (!inTopLeft && !inTopRight && !inBottomLeft) {
        seed = (seed * 1664525 + 1013904223) & 0xffffffff;
        matrix[r][c] = (seed >>> 16) % 2 === 1;
      }
    }
  }

  const cellSize = size / gridSize;

  return (
    <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} className="bg-white p-2 rounded-xl">
      <rect width={size} height={size} fill="#ffffff" />
      {matrix.map((row, r) =>
        row.map((active, c) =>
          active ? (
            <rect
              key={`${r}-${c}`}
              x={c * cellSize}
              y={r * cellSize}
              width={cellSize + 0.3}
              height={cellSize + 0.3}
              fill="#111111"
            />
          ) : null
        )
      )}
    </svg>
  );
};
